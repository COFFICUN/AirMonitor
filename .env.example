# Docker Compose development settings.
# Copy this file to .env at the repository root, then replace the password
# placeholder before running the stack. Docker Compose reaches PostgreSQL by
# the service name "db"; host-side tools use localhost instead.
POSTGRES_DB=airmonitor_development
POSTGRES_USER=airmonitor_developer
POSTGRES_PASSWORD=replace-with-a-local-development-password
AIRMONITOR_API_PORT=8000
# Browser URL for the same-origin frontend gateway: http://127.0.0.1:8080
AIRMONITOR_FRONTEND_PORT=8080
