# Local Python development settings.
# Replace every database placeholder before starting Alembic or the API.
# Docker Compose constructs its own URL with hostname "db" from the root
# .env file; do not use that hostname from a host-side Python process.
AIRMONITOR_APP_NAME=AirMonitor API
AIRMONITOR_APP_VERSION=2.0.0
AIRMONITOR_SERVICE_NAME=airmonitor-api
AIRMONITOR_ENVIRONMENT=development
AIRMONITOR_DEBUG=false
AIRMONITOR_DATABASE_URL=postgresql+asyncpg://<username>:<password>@localhost:5432/<database>
AIRMONITOR_DATABASE_ECHO=false
AIRMONITOR_DATABASE_POOL_PRE_PING=true
